NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public support / legal contact (mailto in footer and policy pages)
# NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
# Optional public site URL for future sitemap / canonical links
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Optional analytics (PostHog): set key to enable page + auth event tracking.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Auth: magic links use emailRedirectTo = this app’s origin + /export-labels. In Supabase Dashboard
# set Authentication → URL Configuration → Redirect URLs to include every origin you use (e.g.
# http://localhost:3000/**, https://your-domain.com/**, http://YOUR_LAN_IP:3000/** for phone testing).
# Optional: service role for trusted server jobs only—do not use for public HTTP routes (use user session + RLS).
SUPABASE_SERVICE_ROLE_KEY=
# Optional dev: extra LAN hostnames for Next allowedDevOrigins (comma-separated). Private 192.168/10/172.* is already covered.
# NEXT_DEV_LAN_ORIGINS=my-mac.local,100.64.1.2
