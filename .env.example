NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used for canonical URLs, sitemap.xml, and robots.txt — set to your production domain.
NEXT_PUBLIC_SITE_URL=https://tulmin.com
# Optional: override default info@tulmin.com in footer and legal pages
# NEXT_PUBLIC_CONTACT_EMAIL=
# Optional public site URL for future sitemap / canonical links
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# ── PostHog (product analytics) ─────────────────────────────────────────────
# 1. Create a project at https://app.posthog.com (or EU: https://eu.posthog.com)
# 2. Project settings → Project API Key → copy the key starting with phc_
# 3. Uncomment and paste below; restart `npm run dev` / redeploy.
#
# US cloud (default if host omitted):
# NEXT_PUBLIC_POSTHOG_KEY=phc_x7XwG4o3xcRdwCyWLZbNxMhS9ED4MuZKYVc98D8jMLEH
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
#
# EU cloud:
# NEXT_PUBLIC_POSTHOG_KEY=phc_x7XwG4o3xcRdwCyWLZbNxMhS9ED4MuZKYVc98D8jMLEH
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
#
# Self-hosted: set host to your instance (e.g. https://posthog.yourdomain.com)
#
# Verbose PostHog console logging (dev only):
# NEXT_PUBLIC_POSTHOG_DEBUG=true
# Auth: magic links use emailRedirectTo = this app’s origin + /export-labels. In Supabase Dashboard
# set Authentication → URL Configuration → Redirect URLs to include every origin you use (e.g.
# http://localhost:3000/**, https://your-domain.com/**, http://YOUR_LAN_IP:3000/** for phone testing).
# Required for protected server APIs such as the admin Blog CMS. Never expose this in client-side code.
SUPABASE_SERVICE_ROLE_KEY=
# Optional dev: extra LAN hostnames for Next allowedDevOrigins (comma-separated). Private 192.168/10/172.* is already covered.
# NEXT_DEV_LAN_ORIGINS=my-mac.local,100.64.1.2
