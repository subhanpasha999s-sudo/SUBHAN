{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next node_modules/.cache",
    "predev": "node scripts/print-lan-dev-hint.mjs",
    "dev": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next dev --webpack --hostname 0.0.0.0",
    "dev:localhost": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next dev --webpack --hostname localhost",
    "dev:turbo": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next dev --turbo --hostname 0.0.0.0",
    "dev:webpack": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next dev --webpack --hostname 0.0.0.0",
    "build": "next build",
    "android:sync": "TULMIN_STATIC_EXPORT=1 next build && npx cap sync android",
    "android:open": "npx cap open android",
    "preview": "npx serve@14 out -l 3000",
    "start": "npx serve@14 out -l 3000",
    "lint": "eslint .",
    "postinstall": "patch-package && (cp node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs public/pdf.worker.min.mjs || true) && (mkdir -p public/ocr/tesseract-core && cp node_modules/tesseract.js/dist/worker.min.js public/ocr/worker.min.js && cp node_modules/@tesseract.js-data/eng/4.0.0/eng.traineddata.gz public/ocr/eng.traineddata.gz && cp node_modules/tesseract.js-core/tesseract-core*.js node_modules/tesseract.js-core/tesseract-core*.wasm public/ocr/tesseract-core/ || true)"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-virtual": "^3.13.24",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "posthog-js": "^1.372.8",
    "razorpay": "^2.9.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.2",
    "@capacitor/cli": "^7.6.2",
    "@capacitor/core": "^7.6.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.29.0",
    "eslint-config-next": "16.2.4",
    "patch-package": "^8.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
